<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro" />

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

   <link name="base_link">
    </link>


    <!-- CHASSIS -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.1 0 0"/>
    </joint>

  <link name="chassis">
    <!-- 1. The Rectangular Rear Section -->
    <visual>
        <origin xyz="0.1075 0 0.04" rpy="0 0 0"/>
        <geometry>
            <box size="0.215 0.17 0.08"/>
        </geometry>
        <material name="white"/>
    </visual>

    <!-- 2. The Rounded Front Section (Cylinder) -->
    <!-- Radius is 0.15 (half of the 0.3 width) to align smoothly with the box -->
    <visual>
        <origin xyz="0.215 0 0.04" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.085" length="0.08"/>
        </geometry>
        <material name="white"/>
    </visual>

    <!-- Remember to replicate the same structure inside your <collision> tags for physics -->
    <collision>
        <origin xyz="0.1075 0 0.04" rpy="0 0 0"/>
        <geometry>
            <box size="0.215 0.17 0.08"/>
        </geometry>
    </collision>
    <collision>
        <origin xyz="0.215 0 0.04" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.085" length="0.08"/>
        </geometry>
    </collision>
     <xacro:inertial_box mass="0.5" x="0.3" y="0.3" z="0.08">
           <origin xyz="0.1075 0 0.04" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="chassis">
      <material>Gazebo/White</material>
  </gazebo>

 <!-- LEFT WHEEL -->

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.0675 0.105 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="0.05" velocity="10.0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.03" radius="0.033" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <!-- <cylinder length="0.03" radius="0.033" />  -->
                <sphere radius="0.033" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.03" radius="0.033">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel">
       <material>Gazebo/Blue</material>
    </gazebo>

    <!-- RIGHT WHEEL -->

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.0675 -0.105 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit effort="0.05" velocity="10.0"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder length="0.03" radius="0.033" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <!-- <cylinder length="0.03" radius="0.033" />  -->
                <sphere radius="0.033" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.03" radius="0.033">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>        
    </link>

    <gazebo reference="right_wheel">
       <material>Gazebo/Blue</material>
    </gazebo>


 <!-- CASTER WHEEL -->

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="caster_wheel"/>
        <origin xyz="0.24 0 0" rpy="0 0 0"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.033" />
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.033" />
            </geometry>
            <material name="black"/>
        </collision>
        <xacro:inertial_sphere mass="0.1" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>        
    </link>

    <gazebo reference="caster_wheel">
       <material>Gazebo/Black</material>
        <mu1 value="0.0"/>
        <mu2 value="0.0"/>
    </gazebo>



</robot>